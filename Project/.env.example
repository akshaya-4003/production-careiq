# CareIQ configuration. Copy this file to .env and edit it:
#
#     cp .env.example .env
#
# .env is in .gitignore; never commit it. Every setting has a working default, so
# CareIQ runs end to end with no .env at all, on the deterministic offline backends.
# A real environment variable always wins over the value written here.

# ---------------------------------------------------------------- language model
# auto    : Gemini when GEMINI_API_KEY is set and the library is installed, else offline
# gemini  : insist on Gemini (fails loudly without a key)
# offline : the deterministic stand-in (what the tests use)
CAREIQ_LLM_BACKEND=auto

# Free tier key from https://aistudio.google.com/apikey. Leave blank to stay offline.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------- embeddings
# auto uses all-MiniLM-L6-v2 when sentence-transformers is installed, else offline.
# The index records which embedder built it; re-run run_knowledge_indexing.py after
# changing this. The test suites expect an index built with the offline embedder.
CAREIQ_EMBEDDING_BACKEND=offline

# ---------------------------------------------------------------- ingestion
# local_csv replays the bundled feed on a timer; snowflake is a documented outline.
CAREIQ_INGESTION_SOURCE=local_csv

# ---------------------------------------------------------------- security
# Replace before any deployment. Signs every access token.
CAREIQ_JWT_SECRET=replace-me-with-a-long-random-string

# ---------------------------------------------------------------- dashboard
CAREIQ_API_BASE_URL=http://localhost:8080
